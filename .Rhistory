# Statistics with R project: India's GDP growth, inflation and unemployment
# Source: World Bank Open Data API via the WDI package. Internet required.
packages <- c("WDI", "dplyr", "tidyr", "ggplot2")
missing <- packages[!packages %in% installed.packages()[, "Package"]]
if(length(missing)) install.packages(missing)
library(WDI); library(dplyr); library(tidyr); library(ggplot2)
# Indicator codes:
# GDP growth = NY.GDP.MKTP.KD.ZG
# Inflation = FP.CPI.TOTL.ZG
# Unemployment = SL.UEM.TOTL.ZS
raw <- WDI(country="IN",
indicator=c(gdp_growth="NY.GDP.MKTP.KD.ZG",
inflation="FP.CPI.TOTL.ZG",
unemployment="SL.UEM.TOTL.ZS"),
start=2000, end=2024, extra=FALSE)
data <- raw %>% select(year, country, gdp_growth, inflation, unemployment) %>%
arrange(year)
analysis_data <- data %>% drop_na(gdp_growth, inflation, unemployment)
cat("Rows downloaded:", nrow(data), "\\n")
cat("Year range:", min(data$year, na.rm=TRUE), "-", max(data$year, na.rm=TRUE), "\\n")
cat("Complete observations:", nrow(analysis_data), "\\n")
cat("\\nSummary statistics:\\n")
print(round(data %>% summarise(
GDP_mean=mean(gdp_growth,na.rm=TRUE), GDP_median=median(gdp_growth,na.rm=TRUE),
GDP_sd=sd(gdp_growth,na.rm=TRUE),
Inflation_mean=mean(inflation,na.rm=TRUE), Inflation_median=median(inflation,na.rm=TRUE),
Inflation_sd=sd(inflation,na.rm=TRUE),
Unemployment_mean=mean(unemployment,na.rm=TRUE),
Unemployment_median=median(unemployment,na.rm=TRUE),
Unemployment_sd=sd(unemployment,na.rm=TRUE)),3))
write.csv(data,"india_economic_indicators_2000_2024.csv",row.names=FALSE)
summary_table <- data %>% summarise(
GDP_mean=mean(gdp_growth,na.rm=TRUE), GDP_median=median(gdp_growth,na.rm=TRUE),
GDP_sd=sd(gdp_growth,na.rm=TRUE),
Inflation_mean=mean(inflation,na.rm=TRUE), Inflation_median=median(inflation,na.rm=TRUE),
Inflation_sd=sd(inflation,na.rm=TRUE),
Unemployment_mean=mean(unemployment,na.rm=TRUE),
Unemployment_median=median(unemployment,na.rm=TRUE),
Unemployment_sd=sd(unemployment,na.rm=TRUE))
write.csv(summary_table,"summary_statistics.csv",row.names=FALSE)
long_data <- data %>% pivot_longer(c(gdp_growth,inflation,unemployment),
names_to="indicator",values_to="value")
p <- ggplot(long_data,aes(year,value)) + geom_line(na.rm=TRUE) +
geom_point(na.rm=TRUE,size=1.5) + facet_wrap(~indicator,scales="free_y",ncol=1) +
labs(title="India: Economic Indicators, 2000–2024",x="Year",y="Annual value (%)") +
theme_minimal()
print(p); ggsave("india_indicator_trends.png",p,width=8,height=9,dpi=300)
cor_matrix <- cor(analysis_data[,c("gdp_growth","inflation","unemployment")],
use="complete.obs",method="pearson")
cat("\\nPearson correlation matrix:\\n"); print(round(cor_matrix,3))
write.csv(round(cor_matrix,3),"correlation_matrix.csv")
p1 <- ggplot(analysis_data,aes(inflation,gdp_growth)) +
geom_point() + geom_smooth(method="lm",se=FALSE) +
labs(title="GDP Growth and Inflation",x="Inflation (%)",y="GDP growth (%)") + theme_minimal()
p2 <- ggplot(analysis_data,aes(unemployment,gdp_growth)) +
geom_point() + geom_smooth(method="lm",se=FALSE) +
labs(title="GDP Growth and Unemployment",x="Unemployment (%)",y="GDP growth (%)") + theme_minimal()
print(p1); print(p2)
ggsave("gdp_vs_inflation.png",p1,width=7,height=5,dpi=300)
ggsave("gdp_vs_unemployment.png",p2,width=7,height=5,dpi=300)
cat("\\nHighest GDP growth observation:\\n")
print(data %>% filter(gdp_growth==max(gdp_growth,na.rm=TRUE)) %>% select(year,gdp_growth))
cat("\\nLowest GDP growth observation:\\n")
print(data %>% filter(gdp_growth==min(gdp_growth,na.rm=TRUE)) %>% select(year,gdp_growth))
cat("\\nImportant: correlation shows association, not causation. Check source metadata and missing values.\\n")
View(analysis_data)
View(analysis_data)
View(cor_matrix)
View(data)
View(long_data)
View(raw)
View(summary_table)
View(long_data)
View(raw)
View(summary_table)
View(summary_table)
View(raw)
View(data)
View(cor_matrix)
View(analysis_data)
View(data)
View(long_data)
View(summary_table)
View(cor_matrix)
View(analysis_data)
View(cor_matrix)
View(summary_table)
View(cor_matrix)
getwd()
